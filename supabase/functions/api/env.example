# Copy to supabase/functions/.env for `supabase functions serve`.
# Sign-in uses this project's Supabase Auth, so no secrets are required.
# Only for local serving, where SUPABASE_URL is not reachable from the browser
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Restrict CORS to your site (comma-separated); defaults to *
# ALLOWED_ORIGINS=https://your-site.example
