{
  // Backend code shared by the "api" Edge Function (Deno) and the backend tests (Node).
  // The Deno entry point itself (supabase/functions/api/index.ts) is checked by Deno on deploy.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["./supabase/functions/_shared"]
}
